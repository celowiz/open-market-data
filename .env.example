# =============================================================================
# Open Market Data — Environment Variables
# =============================================================================
#
# Copy this file to `.env` for local development:
#
#   cp .env.example .env
#
# Never commit `.env` or real credentials.
#
# Local development should work without Cloudflare R2 or Railway.
# Only DATABASE_URL is currently required when using Neon/PostgreSQL.
# =============================================================================


# =============================================================================
# Application
# =============================================================================

# Application environment.
# Allowed values should initially be:
# development | test | production
APP_ENV=development

# Logging level.
LOG_LEVEL=INFO

# Application timezone used for scheduling/reference logic when required.
# Persisted timestamps should still use UTC.
APP_TIMEZONE=America/Sao_Paulo


# =============================================================================
# Database — PostgreSQL
# =============================================================================

# PostgreSQL connection string.
#
# Use a generic URL. The application selects the psycopg3 driver automatically
# when the scheme is postgresql:// or postgres://.
#
# Examples:
#
# Neon:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
#
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_market_data
#
# Required.
DATABASE_URL=

# Optional database connection-pool configuration.
# Defaults should also exist in application code.
# Engines always enable pool_pre_ping. Recycle at 300s so connections are
# replaced before Neon Free (and similar serverless Postgres) drops idle
# clients.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=300


# =============================================================================
# Object Storage
# =============================================================================

# Storage backend used for raw artifacts and generated datasets.
#
# Initial local development:
#   local
#
# Future production:
#   s3
#
# Cloudflare R2 will use the S3-compatible implementation.
OBJECT_STORAGE_BACKEND=local


# -----------------------------------------------------------------------------
# Local filesystem storage
# -----------------------------------------------------------------------------

# Used when OBJECT_STORAGE_BACKEND=local.
LOCAL_STORAGE_PATH=./data


# -----------------------------------------------------------------------------
# S3-compatible object storage
# -----------------------------------------------------------------------------
#
# These values are NOT required during the initial development phase.
#
# They will later support Cloudflare R2 or another S3-compatible provider.
#

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto


# =============================================================================
# HTTP / External Data Sources
# =============================================================================

# User-Agent sent when accessing public data sources.
# The application may append its version automatically.
HTTP_USER_AGENT=open-market-data

# Default HTTP timeout in seconds.
HTTP_TIMEOUT_SECONDS=30

# Default retry count for transient HTTP failures.
HTTP_MAX_RETRIES=3


# =============================================================================
# Ingestion
# =============================================================================

# Number of recent days that providers may reprocess to capture revisions.
# Individual providers may override this behavior.
# CVM (and similar revision-prone sources) should re-fetch recent months.
# Official CVM policy updates M and M-1 daily; a 90-day window is the recommended default.
RECENT_REPROCESS_DAYS=90

# Maximum provider download concurrency.
# Keep conservative values for public/official data sources.
INGESTION_MAX_CONCURRENCY=4

# Optional B3 equity persist-filter for BVBG.186 LAST only. Default is off:
# ingest persists the full 186 file as today.
#
# Scratch / $0 Neon Free:
#   INGEST_UNIVERSE=scratch
#     Reads config/instruments.csv if present, else config/instruments.example.csv.
#     Persists only B3 equity tickers (IBOV+SMLL in the example seed).
#     Tickers outside the list are skipped, not errored.
#   B3_EQUITY_UNIVERSE_PATH=/path/to/universe.csv
#     Explicit coverage-universe CSV (same columns as instruments.example.csv).
#     Wins over INGEST_UNIVERSE.
#
# BVBG.187 futures keep the existing MVP regex; this allowlist does not apply to 187.
# Do not enable COTAHIST (--cotahist) on a scratch run.
# CVM_PROVIDER_ENABLED and TESOURO_PROVIDER_ENABLED exist below but are currently
# ignored by ingest/backfill (only yahoo_provider_enabled is wired). For scratch,
# do not run CVM or Tesouro jobs.
INGEST_UNIVERSE=
B3_EQUITY_UNIVERSE_PATH=


# =============================================================================
# API — FastAPI
# =============================================================================

API_HOST=127.0.0.1
API_PORT=8000

# API root prefix.
API_V1_PREFIX=/v1

# Enable FastAPI documentation endpoints.
API_DOCS_ENABLED=true


# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed frontend origins.
# Empty string = no CORS middleware.
#
# Local Explorer (apps/explorer on port 3000):
CORS_ALLOWED_ORIGINS=http://localhost:3000
#
# When FastAPI is hosted (Railway, after Neon backfill), include the public
# Explorer origin as well:
# CORS_ALLOWED_ORIGINS=https://open-market-data.vercel.app,http://localhost:3000


# =============================================================================
# Public API / Dataset URLs
# =============================================================================

# Public URL of the FastAPI deployment (this Python process).
# Not required for initial local development.
# Do NOT set this on the Vercel Next.js project — that app uses
# NEXT_PUBLIC_API_BASE_URL (see apps/explorer/.env.local.example).
PUBLIC_API_BASE_URL=

# Public base URL used for downloadable datasets (R2/CDN in production).
# FastAPI/Pydantic setting. Not a Vite/Next.js public prefix.
# Do not add PUBLIC_* Python names to Vercel (dashboard rejects them as
# secret; they also do not configure the Explorer).
PUBLIC_DATA_BASE_URL=


# =============================================================================
# Public Dataset Publication
# =============================================================================

# Global publication switch.
#
# Keep false during initial development.
PUBLIC_DATASET_PUBLICATION_ENABLED=false

# Default output format for public analytical datasets.
PUBLIC_DATASET_FORMAT=parquet


# =============================================================================
# Data Source Feature Flags
# =============================================================================
#
# These are application-level defaults.
# Provider-specific configuration may later move to config/sources.yaml.
#

CVM_PROVIDER_ENABLED=true
B3_PROVIDER_ENABLED=true
TESOURO_PROVIDER_ENABLED=true
BCB_PROVIDER_ENABLED=true

# Yahoo should initially be considered development / POC only.
# .env.example stays false. Local .env may set true for development tests.
YAHOO_PROVIDER_ENABLED=false

# ANBIMA remains disabled until access and redistribution rules are reviewed.
ANBIMA_PROVIDER_ENABLED=false


# =============================================================================
# Optional Provider Credentials
# =============================================================================
#
# Most initial official sources are expected not to require authentication.
# Add provider-specific secrets here only when actually required.
#
# Do not add secrets preemptively.
# Do not commit real credentials.
# =============================================================================


# =============================================================================
# Railway
# =============================================================================
#
# Railway infrastructure authentication is handled through Railway MCP/OAuth
# or Railway deployment configuration.
#
# Do NOT store Railway MCP credentials here.
#
# Runtime environment variables required by the application will eventually
# be configured directly in Railway — after Neon serving tables are
# backfilled. Do not create a Railway project from this file. See
# docs/DEPLOYMENT.md (Next operator step: Railway FastAPI).
# =============================================================================


# =============================================================================
# Neon
# =============================================================================
#
# Neon MCP authentication does NOT belong in this file.
#
# The application only needs DATABASE_URL.
# =============================================================================


# =============================================================================
# Cloudflare
# =============================================================================
#
# Cloudflare MCP authentication does NOT belong in this file.
#
# When R2 is enabled, only the S3-compatible runtime credentials required by
# the application should use the OBJECT_STORAGE_* variables above.
# =============================================================================